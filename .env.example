# Reverse proxy host port bound to 127.0.0.1
NGINX_PORT=8080

# PostgreSQL (pgvector)
POSTGRES_USER=pulsar
POSTGRES_PASSWORD=pulsar
POSTGRES_DB=pulsar
DATABASE_URL=postgres://pulsar:pulsar@postgres:5432/pulsar

# Pulsar application
FRONTEND_URL=http://localhost:8080
# Generate a stable secret for production: openssl rand -hex 64
SECRET_KEY_BASE=pulsar-dev-secret-change-me
RUST_LOG=info

# Optional: import an existing Chatwoot database's encrypted attributes
# ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
# ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
# ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# Optional: outbound SMTP & inbound email reply-to domain
# SMTP_ADDRESS=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# MAILER_INBOUND_EMAIL_DOMAIN=

# Optional: Web Push VAPID private key, Google OAuth, Whisper transcription
# VAPID_PRIVATE_KEY=
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# WHISPER_API_URL=
# WHISPER_API_KEY=
# WHISPER_MODEL=whisper-1
